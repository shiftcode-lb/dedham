# Google Places address autocomplete on the booking form (optional).
# Restrict the key to the site domain in Google Cloud. Without it the
# pickup/drop-off fields are plain text inputs.
VITE_GOOGLE_MAPS_API_KEY=

# EmailJS (booking form delivery)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
